rules_version = '2';
// Camel Studios accounts + Camelcord. Paste this into Firebase console > Firestore Database > Rules, then Publish.
// (It is the existing Camel Studios ruleset plus the Camelcord section at the bottom.)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Rate limiting ----
    // rate/{uid} remembers when each kind of write last happened. A throttled write must go in
    // the same batch as a write that stamps its field on rate/{uid} with serverTimestamp(), and the
    // previous stamp must be at least `secs` old, so one account can't spam faster than that.
    function rateDoc() { return /databases/$(database)/documents/rate/$(request.auth.uid); }
    function throttle(field, secs) {
      return request.auth != null
        && getAfter(rateDoc()).data[field] == request.time
        && (!exists(rateDoc()) || !(field in get(rateDoc()).data)
            || request.time >= get(rateDoc()).data[field] + duration.value(secs, 's'));
    }
    // A stamp is only valid when it is the current server time (or left as it was)
    function stampOk(k) {
      return !(k in request.resource.data)
        || request.resource.data[k] == request.time
        || (resource != null && k in resource.data && request.resource.data[k] == resource.data[k]);
    }
    match /rate/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['chat', 'pchat', 'friend', 'party', 'id', 'presence', 'ccmsg', 'ccserver', 'ccchan'])
        && stampOk('chat') && stampOk('pchat') && stampOk('friend')
        && stampOk('party') && stampOk('id') && stampOk('presence')
        && stampOk('ccmsg') && stampOk('ccserver') && stampOk('ccchan');
    }

    // Taken username#tags. The document id is "name#TAG" with the name in lowercase,
    // so every ID can exist only once. There is no update rule: nobody can take over
    // an existing ID, only its owner can delete it (when they change to a new one).
    match /ids/{key} {
      allow read: if true;
      allow create: if request.auth != null && throttle('id', 30)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'tag', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 14
        && request.resource.data.tag is string
        && request.resource.data.tag.matches('^[A-Z0-9]{3,5}$')
        && key == request.resource.data.name.lower() + '#' + request.resource.data.tag;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Which ID each account holds (so the old one can be released on a change)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id']);
    }

    // Per-game progress (Riftline coins and skins, ...). Only the owner can read or write it.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Camel Client / Camelcord: who is online and what they're playing.
    // Any signed-in player can read it; you can only write your own.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && throttle('presence', 10)
        && request.resource.data.keys().hasOnly(['id', 'state', 'game', 'at']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Friends. One document per pair of players; its id is the two account ids in
    // alphabetical order joined with "_". The player who asks creates it as 'pending',
    // only the other player can accept it, and either can remove it.
    match /friends/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && throttle('friend', 5)
        && request.resource.data.keys().hasOnly(['users', 'from', 'status', 'ids', 'at'])
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && pair == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.uid in resource.data.users
        && resource.data.from != request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users
        && request.resource.data.from == resource.data.from;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Private chat between two friends (Camel Client and Camelcord direct messages). The chat id
    // is the same pair id as their friendship, and only those two (while they are friends) can
    // read or post. Messages can't be edited.
    match /chats/{pair}/messages/{msg} {
      allow read: if request.auth != null && request.auth.uid in pair.split('_');
      allow create: if request.auth != null && request.auth.uid in pair.split('_') && throttle('chat', 1)
        && request.resource.data.keys().hasOnly(['from', 'text', 'img', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (request.resource.data.text.size() > 0 || ('img' in request.resource.data))
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 900000))
        && get(/databases/$(database)/documents/friends/$(pair)).data.status == 'accepted';
      // Reactions: either friend may change only the 're' map
      allow update: if request.auth != null && request.auth.uid in pair.split('_')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['re']);
    }

    // Camel Client: parties of up to 4. Only members and invited players can see a party.
    // The leader never changes; the leader can disband it, anyone else can leave.
    match /parties/{party} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if request.auth != null && throttle('party', 10)
        && request.resource.data.keys().hasOnly(['leader', 'members', 'invited', 'ids', 'game', 'code', 'at'])
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited)
        && request.resource.data.keys().hasOnly(['leader', 'members', 'invited', 'ids', 'game', 'code', 'at'])
        && request.resource.data.leader == resource.data.leader
        && request.resource.data.members.size() <= 4
        && request.resource.data.code is string && request.resource.data.code.size() <= 12
        && request.resource.data.game is string && request.resource.data.game.size() <= 30;
      allow delete: if request.auth != null && resource.data.leader == request.auth.uid;

      match /messages/{msg} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/parties/$(party)).data.members;
        allow create: if request.auth != null && throttle('pchat', 1)
          && request.auth.uid in get(/databases/$(database)/documents/parties/$(party)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      }
    }

    // =================================================================== CAMELCORD
    function srv(sid) { return get(/databases/$(database)/documents/cc_servers/$(sid)).data; }
    function srvAfter(sid) { return getAfter(/databases/$(database)/documents/cc_servers/$(sid)).data; }
    function inServer(sid) { return request.auth != null && request.auth.uid in srv(sid).members; }
    function inPair(pair) { return request.auth != null && request.auth.uid in pair.split('_'); }
    function voiceOk(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'session', 'muted', 'deafened', 'at'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 40
        && request.resource.data.session is string && request.resource.data.session.size() <= 16;
    }
    function signalOk() {
      return request.resource.data.keys().hasOnly(['from', 'to', 'session', 'toSession', 'kind', 'data'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.kind in ['offer', 'answer', 'ice']
        && request.resource.data.data is string && request.resource.data.data.size() <= 8000;
    }

    // A server: members, who they are, and an invite code. The owner edits it, removes members
    // and deletes it. Anyone with a live invite can add themselves; any member except the owner
    // can remove themselves.
    match /cc_servers/{sid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && throttle('ccserver', 10)
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'ids', 'icon', 'color', 'invite', 'img', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 12
        && request.resource.data.color is string && request.resource.data.color.size() <= 9
        && request.resource.data.invite is string && request.resource.data.invite.size() >= 4 && request.resource.data.invite.size() <= 12;
      allow update: if request.auth != null
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'ids', 'icon', 'color', 'invite', 'img', 'at'])
        && (
          // the owner: rename, change the look, new invite, remove members
          (request.auth.uid == resource.data.owner
            && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
            && request.auth.uid in request.resource.data.members)
          // someone joining with a live invite: only adds themselves
          || (!(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= 50
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'ids'])
            && request.resource.data.ids.diff(resource.data.ids).affectedKeys().hasOnly([request.auth.uid])
            && exists(/databases/$(database)/documents/cc_invites/$(resource.data.invite)))
          // a member leaving: only removes themselves
          || (request.auth.uid in resource.data.members
            && request.auth.uid != resource.data.owner
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'ids']))
        );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Custom emoji: any member can add one; the person who added it or the owner can remove it.
    match /cc_servers/{sid}/emoji/{name} {
      allow read: if inServer(sid);
      allow create, update: if inServer(sid)
        && name.matches('^[a-z0-9_]{2,20}$')
        && request.resource.data.keys().hasOnly(['name', 'img', 'by', 'at'])
        && request.resource.data.name == name
        && request.resource.data.by == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() <= 80000;
      allow delete: if request.auth != null
        && (resource.data.by == request.auth.uid || srv(sid).owner == request.auth.uid);
    }

    // Channels belong to a server; only the owner makes, renames and removes them.
    match /cc_servers/{sid}/channels/{cid} {
      allow read: if inServer(sid);
      allow create: if request.auth != null && srvAfter(sid).owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'kind', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.kind in ['text', 'voice'];
      allow update: if request.auth != null && srv(sid).owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'kind', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.kind == resource.data.kind;
      allow delete: if request.auth != null && srv(sid).owner == request.auth.uid;

      // Text messages: members read and post; the author or the server owner can delete.
      match /messages/{mid} {
        allow read: if inServer(sid);
        allow create: if inServer(sid) && throttle('ccmsg', 1)
          && request.resource.data.keys().hasOnly(['from', 'text', 'img', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || ('img' in request.resource.data))
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 900000));
        // Reactions: any member may change only the 're' map
        allow update: if inServer(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['re']);
        allow delete: if request.auth != null
          && (resource.data.from == request.auth.uid || srv(sid).owner == request.auth.uid);
      }

      // Voice: who is in the channel, and the WebRTC signals between them
      match /voice/{uid} {
        allow read: if inServer(sid);
        allow create, update: if inServer(sid) && voiceOk(uid);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /signals/{sig} {
        allow read: if inServer(sid) && resource.data.to == request.auth.uid;
        allow create: if inServer(sid) && signalOk();
        allow delete: if request.auth != null
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    // Profiles: anyone signed in can read one; you can only write your own.
    match /cc_profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'avatar', 'banner', 'accent', 'nameColor', 'bio', 'status', 'at'])
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 120000
        && request.resource.data.banner is string && request.resource.data.banner.size() <= 300000
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 190
        && request.resource.data.status is string && request.resource.data.status.size() <= 60
        && request.resource.data.accent is string && request.resource.data.accent.size() <= 9
        && request.resource.data.nameColor is string && request.resource.data.nameColor.size() <= 9;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Invite codes: anyone signed in can look one up by its code (not list them).
    match /cc_invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['sid', 'name', 'icon', 'color', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && srvAfter(request.resource.data.sid).owner == request.auth.uid
        && srvAfter(request.resource.data.sid).invite == code;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Calls between two friends: cc_calls/{pairId}. The caller rings, either one can end it.
    match /cc_calls/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if inPair(pair)
        && request.resource.data.keys().hasOnly(['users', 'from', 'state', 'at'])
        && request.resource.data.users == pair.split('_')
        && request.resource.data.from == request.auth.uid
        && request.resource.data.state == 'ringing'
        && get(/databases/$(database)/documents/friends/$(pair)).data.status == 'accepted';
      allow update: if request.auth != null && request.auth.uid in resource.data.users
        && request.resource.data.keys().hasOnly(['users', 'from', 'state', 'at'])
        && request.resource.data.users == resource.data.users
        && request.resource.data.state in ['ringing', 'active']
        && (request.resource.data.from == resource.data.from
            || (request.resource.data.from == request.auth.uid && request.resource.data.state == 'ringing'));
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;

      match /voice/{uid} {
        allow read: if inPair(pair);
        allow create, update: if inPair(pair) && voiceOk(uid);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /signals/{sig} {
        allow read: if inPair(pair) && resource.data.to == request.auth.uid;
        allow create: if inPair(pair) && signalOk();
        allow delete: if request.auth != null
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }
  }
}
